# Database
DATABASE_URL="postgresql://echogpt:echogpt@localhost:5432/echogpt?schema=public"

# App
NODE_ENV="development"
PORT=3000
CORS_ORIGINS="http://localhost:5173"

# Auth
# 32-byte base64 string used to encrypt provider API keys (AES-256-GCM).
# Generate one with: openssl rand -base64 32
ENCRYPTION_KEY="replace-with-32-byte-base64-key"
JWT_ACCESS_SECRET="replace-with-access-secret"
JWT_REFRESH_SECRET="replace-with-refresh-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# Seed admin user
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-please"

# AI providers (optional in development)
# When AI_MOCK_MODE=true, or a provider has no API key, a mock adapter is used.
AI_MOCK_MODE="true"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
