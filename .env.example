# Database
# Local runs (app on the host, database in Docker): use host "localhost".
# Docker Compose runs (app inside the compose network): use host "postgres".
DATABASE_URL="postgresql://echogpt:echogpt@localhost:5432/echogpt?schema=public"

# App
NODE_ENV="development"
PORT=3000
CORS_ORIGINS="http://localhost:5173"

# Auth
# 32-byte base64 string used to encrypt provider API keys (AES-256-GCM).
# Generate one with: openssl rand -base64 32
ENCRYPTION_KEY="replace-with-32-byte-base64-key"
# Both JWT secrets must be at least 32 characters long.
JWT_ACCESS_SECRET="replace-with-access-secret-at-least-32-chars"
JWT_REFRESH_SECRET="replace-with-refresh-secret-at-least-32-chars"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# Seed admin user. ADMIN_PASSWORD must be at least 12 characters and must not
# be this placeholder, or the seed script exits with an error.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-please"

# AI providers
# Provider API keys are NOT configured here. Each user adds their own key via
# POST /api/v1/providers, and it is stored encrypted with ENCRYPTION_KEY.
#
# When AI_MOCK_MODE=true, chat requests are answered by a mock adapter and no
# external AI API is called. Set it to false to use the user's real provider
# keys, then add a key through the API or Swagger UI.
AI_MOCK_MODE="true"

# Web search
# The search backend (DuckDuckGo Instant Answer) needs no API key.
# Cached results older than this are refetched.
SEARCH_CACHE_TTL_MINUTES="360"
